# extra kmods (=m) for the v2 package repository, on top of his kmods-extra.config
# zram (for zram-swap from the packages feed): 256 MB of RAM, 34-42 MB of it available. His
# repository has it only because another board of his 256m group selects it.
CONFIG_PACKAGE_kmod-zram=m
# The ISP tunnels besides PPPoE (#56): PPP over L2TP (l2tp_ppp.ko) and PPTP (pptp.ko, plus
# ppp_mppe.ko: OpenWrt's /etc/ppp/options.pptp requires MPPE-128). A new kmod moves vermagic,
# so it cannot be added to a published release's repository afterwards; hence both at once.
# NSS/ECM do not offload these sessions: his ECM builds with ECM_INTERFACE_L2TPV2_ENABLE=n and
# ECM_INTERFACE_PPTP_ENABLE=n (the kernel hooks are not ported), and ppp_channel_get_protocol()
# returns -1 for these channels, so ECM treats the PPP device as an unknown interface and leaves
# its flows to the kernel.
CONFIG_PACKAGE_kmod-pppol2tp=m
CONFIG_PACKAGE_kmod-pptp=m
CONFIG_PACKAGE_kmod-mppe=m
