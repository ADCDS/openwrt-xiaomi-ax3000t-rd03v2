From b09e1540d1d2a1efe44cb2437ab572a15111c4fa Mon Sep 17 00:00:00 2001
From: Stanislaw Pal <kuncy7@gmail.com>
Date: Thu, 15 Oct 2026 20:52:17 +0200
Subject: [PATCH] mac80211: cfg80211: keep the DFS state when a
 self-managed wiphy applies its domain again

After a restart of the radio firmware ath11k applies its regulatory
domain again, and cfg80211 starts every channel at DFS state usable
when it does. 60 s later the regulatory enforcement leaves every AP and
mesh on a chandef that needs DFS: carrier and channel gone, hostapd
still reporting the AP as enabled. Reported on a Xiaomi AX6000 (QCN9074,
issue 28) and reproduced on an Archer AX55 v1 (QCN6122) at 160 MHz on
channel 36.

Keep the DFS state of the channels whose place in the DFS scheme did
not change when a self-managed wiphy applies its domain again. With it
six firmware crashes on both sides of a 160 MHz mesh between a GL-B3000
and an Archer AX55 v1 kept the channels available and the AP and the
mesh up.

Upstream: https://github.com/kuncy7/openwrt-nss-edma/commit/238d30761029066c6fdc4897c053c254facf648c (ipq50xx-2026.10.15-2, kuncy7/openwrt-nss-edma#28)

Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ...naged-wiphy-applies-its-domain-again.patch | 155 ++++++++++++++++++
 1 file changed, 155 insertions(+)
 create mode 100644 package/kernel/mac80211/patches/subsys/990-wifi-cfg80211-keep-the-DFS-state-when-a-self-managed-wiphy-applies-its-domain-again.patch

diff --git a/package/kernel/mac80211/patches/subsys/990-wifi-cfg80211-keep-the-DFS-state-when-a-self-managed-wiphy-applies-its-domain-again.patch b/package/kernel/mac80211/patches/subsys/990-wifi-cfg80211-keep-the-DFS-state-when-a-self-managed-wiphy-applies-its-domain-again.patch
new file mode 100644
index 0000000000..d95b06ab02
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/990-wifi-cfg80211-keep-the-DFS-state-when-a-self-managed-wiphy-applies-its-domain-again.patch
@@ -0,0 +1,155 @@
+From: Stanislaw Pal <kuncy7@gmail.com>
+Subject: [PATCH] wifi: cfg80211: keep the DFS state when a self-managed wiphy applies its domain again
+
+A self-managed wiphy applies its regulatory domain again whenever the
+driver asks, and ath11k asks after every restart of its firmware: the
+firmware sends its channel list again and the driver passes it on.
+handle_channel_custom() starts every channel at NL80211_DFS_USABLE, so
+the "available" that a completed CAC had earned is lost at that moment.
+Nothing acts on it right away; reg_check_chans_work() does, 60 s later
+(REG_ENFORCE_GRACE_MS): an AP or a mesh on a chandef that needs DFS is
+on channels that are only usable now, so it is left - carrier and
+channel gone, NL80211_CMD_STOP_AP sent, which hostapd only logs at
+debug level and keeps reporting the AP as enabled.
+
+Seen on an Archer AX55 v1 (QCN6122) and reported on a Xiaomi AX6000
+(QCN9074): AP and mesh on channel 36 at 160 MHz, which takes in 52-64,
+a simulated crash of the 5 GHz firmware, recovery in 5 s, "DFS state:
+usable" 7 s after the crash, and carrier and channel gone 61 s after
+that. The same at 80 MHz is fine.
+
+Save the DFS state of every channel before the domain is applied and
+put it back on the channels whose place in the DFS scheme did not
+change - radar before and after, not disabled, the domain's DFS region
+the same - the conditions under which reg_copy_dfs_chan_state() already
+carries a state from one wiphy to another. A domain with another DFS
+region, or a channel that gained or lost its radar flag, starts from
+usable as before.
+
+Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
+
+--- a/net/wireless/reg.c
++++ b/net/wireless/reg.c
+@@ -3147,11 +3147,102 @@
+ 	spin_unlock_bh(&reg_pending_beacons_lock);
+ }
+ 
++/* The DFS state of a channel before a regulatory domain is applied to the
++ * wiphy, see reg_dfs_state_save().
++ */
++struct reg_dfs_chan_state {
++	u32 flags;
++	enum nl80211_dfs_state dfs_state;
++	unsigned long dfs_state_entered;
++	unsigned long dfs_state_last_available;
++};
++
++/* handle_channel_custom() starts every channel at NL80211_DFS_USABLE, so a
++ * self-managed wiphy that applies a domain again - a driver does so after a
++ * restart of its firmware - loses the CAC results it had. Nothing acts on
++ * that right away, but reg_check_chans_work() does REG_ENFORCE_GRACE_MS
++ * later: an AP or mesh running on a channel that needs DFS is then left,
++ * carrier and channel gone, and nothing tells userspace in a way it acts on.
++ * Save the states before the domain is applied and put them back for the
++ * channels whose place in the DFS scheme did not change: radar before and
++ * after, not disabled, and the domain's DFS region the same - what
++ * reg_copy_dfs_chan_state() takes as safe between two wiphys.
++ */
++static struct reg_dfs_chan_state *reg_dfs_state_save(struct wiphy *wiphy)
++{
++	struct reg_dfs_chan_state *saved, *s;
++	struct ieee80211_supported_band *sband;
++	enum nl80211_band band;
++	unsigned int n = 0, i;
++
++	for (band = 0; band < NUM_NL80211_BANDS; band++) {
++		sband = wiphy->bands[band];
++		if (sband)
++			n += sband->n_channels;
++	}
++
++	saved = kcalloc(n, sizeof(*saved), GFP_KERNEL);
++	if (!saved)
++		return NULL;
++
++	s = saved;
++	for (band = 0; band < NUM_NL80211_BANDS; band++) {
++		sband = wiphy->bands[band];
++		if (!sband)
++			continue;
++		for (i = 0; i < sband->n_channels; i++, s++) {
++			const struct ieee80211_channel *chan = &sband->channels[i];
++
++			s->flags = chan->flags;
++			s->dfs_state = chan->dfs_state;
++			s->dfs_state_entered = chan->dfs_state_entered;
++			s->dfs_state_last_available =
++				chan->dfs_state_last_available;
++		}
++	}
++
++	return saved;
++}
++
++static void reg_dfs_state_restore(struct wiphy *wiphy,
++				  const struct reg_dfs_chan_state *saved)
++{
++	struct ieee80211_supported_band *sband;
++	const struct reg_dfs_chan_state *s = saved;
++	enum nl80211_band band;
++	unsigned int i;
++
++	for (band = 0; band < NUM_NL80211_BANDS; band++) {
++		sband = wiphy->bands[band];
++		if (!sband)
++			continue;
++		for (i = 0; i < sband->n_channels; i++, s++) {
++			struct ieee80211_channel *chan = &sband->channels[i];
++
++			if (!(s->flags & IEEE80211_CHAN_RADAR) ||
++			    s->flags & IEEE80211_CHAN_DISABLED)
++				continue;
++			if (!(chan->flags & IEEE80211_CHAN_RADAR) ||
++			    chan->flags & IEEE80211_CHAN_DISABLED)
++				continue;
++			if (chan->dfs_state != NL80211_DFS_USABLE ||
++			    s->dfs_state == NL80211_DFS_USABLE)
++				continue;
++
++			chan->dfs_state = s->dfs_state;
++			chan->dfs_state_entered = s->dfs_state_entered;
++			chan->dfs_state_last_available =
++				s->dfs_state_last_available;
++		}
++	}
++}
++
+ static void reg_process_self_managed_hint(struct wiphy *wiphy)
+ {
+ 	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+ 	const struct ieee80211_regdomain *tmp;
+ 	const struct ieee80211_regdomain *regd;
++	struct reg_dfs_chan_state *dfs_saved = NULL;
+ 	enum nl80211_band band;
+ 	struct regulatory_request request = {};
+ 
+@@ -3167,12 +3258,19 @@
+ 		return;
+ 
+ 	tmp = get_wiphy_regdom(wiphy);
++	if (tmp && tmp->dfs_region == regd->dfs_region)
++		dfs_saved = reg_dfs_state_save(wiphy);
+ 	rcu_assign_pointer(wiphy->regd, regd);
+ 	rcu_free_regdom(tmp);
+ 
+ 	for (band = 0; band < NUM_NL80211_BANDS; band++)
+ 		handle_band_custom(wiphy, wiphy->bands[band], regd);
+ 
++	if (dfs_saved) {
++		reg_dfs_state_restore(wiphy, dfs_saved);
++		kfree(dfs_saved);
++	}
++
+ 	reg_process_ht_flags(wiphy);
+ 
+ 	request.wiphy_idx = get_wiphy_idx(wiphy);
-- 
2.47.3

