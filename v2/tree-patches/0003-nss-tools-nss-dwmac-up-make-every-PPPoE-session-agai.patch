From 4baa5e723756184d1807309fb9aead7b2fffeeff Mon Sep 17 00:00:00 2001
From: Adriel Santos <adriel@adriel.eu>
Date: Mon, 12 Oct 2026 09:47:44 -0300
Subject: [PATCH] nss-tools: nss-dwmac-up: re-dial every existing PPPoE session

Port his accepted b2b6b3fff8 refinement onto the pinned 10-09 tree. A
session whose netdev exists before netifd declares it up must also be
re-created, and pppname is honoured. The package release is bumped so the
changed package is told apart from his.

Upstream: https://github.com/kuncy7/openwrt-nss-edma/commit/b2b6b3fff8b85f6f202c7ae3e129b39b0817f100
---
 package/nss/nss-tools/Makefile           |  2 +-
 package/nss/nss-tools/files/nss-dwmac-up | 39 ++++++++++++++----------
 2 files changed, 24 insertions(+), 17 deletions(-)

diff --git a/package/nss/nss-tools/Makefile b/package/nss/nss-tools/Makefile
index bbd4a1e8de..a997235033 100644
--- a/package/nss/nss-tools/Makefile
+++ b/package/nss/nss-tools/Makefile
@@ -6,7 +6,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=nss-tools
-PKG_RELEASE:=13
+PKG_RELEASE:=14
 
 include $(INCLUDE_DIR)/package.mk
 
diff --git a/package/nss/nss-tools/files/nss-dwmac-up b/package/nss/nss-tools/files/nss-dwmac-up
index 348fc7a05a..46ec716878 100644
--- a/package/nss/nss-tools/files/nss-dwmac-up
+++ b/package/nss/nss-tools/files/nss-dwmac-up
@@ -277,22 +277,29 @@ poll_until 15 ecm_ready &&
 # image and client). So make it again with the manager resident, which is
 # what the 'ifup wan' in nss-up does on ipq807x. Only for a PPPoE WAN: no
 # other WAN type has anything to re-register.
-if [ -n "$(ls -d /sys/class/net/pppoe-* 2>/dev/null)" ]; then
-	. /lib/functions/network.sh
-	network_find_wan wan_iface
-	[ -n "$wan_iface" ] || wan_iface=wan
-	ifup "$wan_iface"
-	wan_has_addr() {
-		_d="$(ifstatus "$wan_iface" 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
-		[ -n "$_d" ] || return 1
-		ip -4 addr show dev "$_d" 2>/dev/null | grep -q "inet "
-	}
-	if poll_until 30 wan_has_addr; then
-		echo "PPPoE: $wan_iface re-created with the NSS manager resident"
-	else
-		echo "WARN: $wan_iface has no address 30s after the PPPoE re-up - WAN flows will stay on the host path"
-	fi
-fi
+# Pick PPPoE sessions by their netdev, including the authentication window.
+# network_find_wan instead names whichever WAN holds the default route.
+pppoe_ifaces=''
+for _i in $(ubus call network.interface dump 2>/dev/null |
+        jsonfilter -e '@.interface[@.proto="pppoe"].interface' 2>/dev/null); do
+    _n="$(uci -q get "network.$_i.pppname")" || _n=''
+    [ -e "/sys/class/net/${_n:-pppoe-$_i}" ] && pppoe_ifaces="$pppoe_ifaces $_i"
+done
+iface_has_addr() {
+    _d="$(ifstatus "$1" 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
+    [ -n "$_d" ] || return 1
+    ip -4 addr show dev "$_d" 2>/dev/null | grep -q "inet "
+}
+for wan_iface in $pppoe_ifaces; do
+    ifup "$wan_iface"
+done
+for wan_iface in $pppoe_ifaces; do
+    if poll_until 30 iface_has_addr "$wan_iface"; then
+        echo "PPPoE: $wan_iface re-created with the NSS manager resident"
+    else
+        echo "WARN: $wan_iface has no address 30s after the PPPoE re-up - its flows will stay on the host path"
+    fi
+done
 
 # Drop any connections tracked before ECM loaded so they re-classify
 # through the accelerated path.
-- 
2.47.3

