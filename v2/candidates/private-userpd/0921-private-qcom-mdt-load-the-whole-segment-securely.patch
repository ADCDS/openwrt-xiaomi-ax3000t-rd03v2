From: Adriel Santos <adriel@adriel.eu>
Subject: [PATCH] soc: qcom: mdt_loader: load a user PD's whole segment securely

A reloaded user PD has to start with a cleared bss. The host cannot clear it
itself: that memory is protected while the root PD runs, and writing it through
the driver's ioremap resets the board about 15 ms into the reload, with no
kernel log at all. The secure loader can, so send it the whole segment.

mdt_load_split_segment_dma() loaded only phdr->p_filesz bytes, and
__qcom_mdt_load() only reached it for segments that have file data, so a
pure-BSS segment was never sent to the secure loader at all. Segment 12 of
ASID 1 on this board is 757760 bytes of pure bss with filesz 0, and the tails
of the other segments were left with the previous firmware's contents.

Allocate p_memsz with kvzalloc(), fill the file-backed part as before, and
load p_memsz, then let the path run for every segment the ASID filter accepts
rather than only the ones with filesz. The cold-boot path is untouched.

Measured without this, on b10d2, 2.4 GHz hw-restart:

  [742.283] userpd trace: power-up complete id=1
            (no chip_id/fw_version follows - the QMI server never comes up)
  [752.487] ath11k c000000.wifi: failed to enable PMF QOS: (-108
  [754.865] remotecproc remoteproc0: crash detected in q6wcss: type fatal error

Signed-off-by: Adriel Santos <adriel@adriel.eu>
---
--- a/drivers/soc/qcom/mdt_loader.c
+++ b/drivers/soc/qcom/mdt_loader.c
@@ -115,25 +115,35 @@
 	void *data;
 	int ret;
 
-	data = kvmalloc(phdr->p_filesz, GFP_KERNEL);
+	/*
+	 * Load the whole segment, not only its file-backed part. The secure
+	 * loader is the only thing that can write this memory while the root PD
+	 * is running - a host write to it resets the board - so a reloaded user
+	 * PD gets a cleared bss only if it is sent through here. A pure-BSS
+	 * segment (p_filesz == 0) is nothing but bss and is loaded here too;
+	 * kvzalloc() leaves the tail of the others zeroed.
+	 */
+	data = kvzalloc(phdr->p_memsz, GFP_KERNEL);
 	if (!data)
 		return -ENOMEM;
 
-	if (is_split) {
-		ret = mdt_load_split_segment(data, phdrs, segment, fw_name, dev);
-		if (ret)
-			goto free_data;
-	} else {
-		if (phdr->p_offset > fw->size ||
-		    phdr->p_filesz > fw->size - phdr->p_offset) {
-			ret = -EINVAL;
-			goto free_data;
-		}
-		memcpy(data, fw->data + phdr->p_offset, phdr->p_filesz);
+	if (phdr->p_filesz) {
+		if (is_split) {
+			ret = mdt_load_split_segment(data, phdrs, segment, fw_name, dev);
+			if (ret)
+				goto free_data;
+		} else {
+			if (phdr->p_offset > fw->size ||
+			    phdr->p_filesz > fw->size - phdr->p_offset) {
+				ret = -EINVAL;
+				goto free_data;
+			}
+			memcpy(data, fw->data + phdr->p_offset, phdr->p_filesz);
+		}
 	}
 
 	ret = qcom_scm_pas_load_segment(pas_id, segment, data,
-					phdr->p_filesz);
+					phdr->p_memsz);
 
 free_data:
 	kvfree(data);
@@ -460,7 +470,7 @@
 
 		ptr = mem_region + offset;
 
-		if (dma_required && phdr->p_filesz) {
+		if (dma_required) {
 			ret = mdt_load_split_segment_dma(pas_id, i, fw, is_split,
 							 phdrs, fw_name, dev);
 			if (ret)
@@ -468,7 +478,7 @@
 			loaded++;
 			dev_info(dev,
 				 "rd03v2 userpd trace: secure reload asid=%d segment=%d bytes=%u\n",
-				 pd_asid, i, phdr->p_filesz);
+				 pd_asid, i, phdr->p_memsz);
 		} else if (phdr->p_filesz && !is_split) {
 			/* Firmware is large enough to be non-split */
 			if (phdr->p_offset > fw->size ||
