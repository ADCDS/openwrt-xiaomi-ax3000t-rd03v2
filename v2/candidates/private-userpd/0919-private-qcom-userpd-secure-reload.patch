 };
 
 struct wcss_data {
@@ -103,6 +108,10 @@
 	ret = qcom_q6v5_wait_for_start(&wcss->q6, Q6_WAIT_TIMEOUT);
 	if (ret == -ETIMEDOUT)
 		dev_err(dev, "start timed out\n");
+	else if (!ret) {
+		if (!++wcss->boot_generation)
