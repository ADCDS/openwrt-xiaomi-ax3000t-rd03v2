From: Adriel Santos <adriel@adriel.eu>
Subject: [PATCH] qcom: add bounded secure user-PD reload support

Diagnostic candidate. Restore the ASID-scoped PAS segment-loading and MSA
operations needed to test a stopped WCSS user PD without overwriting the
live root or another PD. The WCSS owner serializes reloads against root
lifecycle changes and binds each transition to a boot generation.

Signed-off-by: Adriel Santos <adriel@adriel.eu>
---
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -894,6 +894,122 @@
 }
 EXPORT_SYMBOL_GPL(qcom_scm_pas_set_wifi_power_mode);
 
+static int qcom_scm_mpd_state(u32 peripheral, u32 command)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_PIL,
+		.cmd = command,
+		.arginfo = QCOM_SCM_ARGS(1),
+		.args[0] = peripheral,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	int ret;
+
+	if (!__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_PIL,
+					  command))
+		return -EOPNOTSUPP;
+
+	ret = qcom_scm_clk_enable();
+	if (ret)
+		return ret;
+
+	ret = qcom_scm_bw_enable();
+	if (ret)
+		goto disable_clk;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	qcom_scm_bw_disable();
+
+disable_clk:
+	qcom_scm_clk_disable();
+
+	return ret ? : res.result[0];
+}
+
+int qcom_scm_msa_lock(u32 peripheral)
+{
+	return qcom_scm_mpd_state(peripheral, QCOM_SCM_MSA_LOCK);
+}
+EXPORT_SYMBOL_GPL(qcom_scm_msa_lock);
+
+int qcom_scm_msa_unlock(u32 peripheral)
+{
+	return qcom_scm_mpd_state(peripheral, QCOM_SCM_MSA_UNLOCK);
+}
+EXPORT_SYMBOL_GPL(qcom_scm_msa_unlock);
+
+int qcom_scm_pas_load_segment(u32 peripheral, int segment,
+			      const void *data, size_t size)
+{
+	struct qcom_scm_pas_segment_args {
+		__le64 addr;
+		__le64 block_size;
+		__le64 data_addr;
+	} *args;
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_PIL,
+		.cmd = QCOM_SCM_PIL_PAS_LOAD_SEG,
+		.arginfo = QCOM_SCM_ARGS(4, QCOM_SCM_VAL, QCOM_SCM_VAL,
+					 QCOM_SCM_RW, QCOM_SCM_VAL),
+		.args[0] = peripheral,
+		.args[1] = segment,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	dma_addr_t dma_args, dma_data;
+	void *data_buffer;
+	int ret;
+
+	if (!__qcom_scm_is_call_available(__scm->dev, QCOM_SCM_SVC_PIL,
+					  QCOM_SCM_PIL_PAS_LOAD_SEG))
+		return -EOPNOTSUPP;
+	if (!data || !size)
+		return -EINVAL;
+
+	args = dma_alloc_coherent(__scm->dev, sizeof(*args), &dma_args,
+				  GFP_KERNEL);
+	if (!args)
+		return -ENOMEM;
+
+	data_buffer = dma_alloc_coherent(__scm->dev, size, &dma_data,
+					 GFP_KERNEL);
+	if (!data_buffer) {
+		ret = -ENOMEM;
+		goto free_args;
+	}
+
+	memcpy(data_buffer, data, size);
+	args->addr = cpu_to_le64(dma_args + offsetof(struct qcom_scm_pas_segment_args,
+						     data_addr));
+	args->block_size = cpu_to_le64(size);
+	args->data_addr = cpu_to_le64(dma_data);
+	desc.args[2] = dma_args;
+	desc.args[3] = 1;
+
+	ret = qcom_scm_clk_enable();
+	if (ret)
+		goto free_data;
+
+	ret = qcom_scm_bw_enable();
+	if (ret)
+		goto disable_clk;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	qcom_scm_bw_disable();
+
+disable_clk:
+	qcom_scm_clk_disable();
+
+	ret = ret ? : res.result[0];
+free_data:
+	dma_free_coherent(__scm->dev, size, data_buffer, dma_data);
+free_args:
+	dma_free_coherent(__scm->dev, sizeof(*args), args, dma_args);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_pas_load_segment);
+
 static int __qcom_scm_pas_mss_reset(struct device *dev, bool reset)
 {
 	struct qcom_scm_desc desc = {
