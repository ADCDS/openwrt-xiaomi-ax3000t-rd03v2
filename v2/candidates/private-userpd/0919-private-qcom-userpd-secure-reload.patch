 }
 
+static int wcss_userpd_check(struct rproc *rproc, struct wcss_sec *wcss,
+			     u32 root_generation)
+{
+	if (rproc->state != RPROC_RUNNING || !wcss->q6.running)
+		return -ENODEV;
+	if (root_generation && root_generation != wcss->boot_generation)
+		return -ESTALE;
+
+	return 0;
+}
+
+int qcom_wcss_userpd_unprepare(struct rproc *rproc, u32 pd_asid,
+			       u32 *root_generation)
+{
+	struct wcss_sec *wcss;
+	u32 pasid;
+	int ret;
+
+	if (!rproc || !root_generation || pd_asid < 1 || pd_asid > 3)
+		return -EINVAL;
+
+	mutex_lock(&rproc->lock);
+	wcss = rproc->priv;
+	ret = wcss_userpd_check(rproc, wcss, 0);
+	if (ret)
+		goto unlock;
+
+	pasid = (pd_asid << 8) | UPD_SWID;
+	dev_info(wcss->dev,
+		 "rd03v2 userpd trace: MSA unlock asid=%u generation=%u\n",
+		 pd_asid, wcss->boot_generation);
+	ret = qcom_scm_msa_unlock(pasid);
+	if (ret == -EOPNOTSUPP) {
+		wcss->userpd_msa_unsupported = true;
+		dev_info(wcss->dev,
+			 "rd03v2 userpd trace: MSA calls unsupported; continuing without them\n");
+		ret = 0;
+	}
+	if (!ret)
+		*root_generation = wcss->boot_generation;
+
+unlock:
+	mutex_unlock(&rproc->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_wcss_userpd_unprepare);
+
+int qcom_wcss_userpd_prepare(struct rproc *rproc, u32 pd_asid,
+			     u32 root_generation)
+{
+	struct wcss_sec *wcss;
+	const struct firmware *firmware;
+	u32 pasid;
+	int ret;
+
+	if (!rproc || !root_generation || pd_asid < 1 || pd_asid > 3)
+		return -EINVAL;
+
+	mutex_lock(&rproc->lock);
+	wcss = rproc->priv;
+	ret = wcss_userpd_check(rproc, wcss, root_generation);
+	if (ret)
+		goto unlock;
+
+	ret = request_firmware(&firmware, rproc->firmware, wcss->dev);
+	if (ret)
+		goto unlock;
+
+	ret = qcom_mdt_load_pd_seg(wcss->dev, firmware, rproc->firmware,
+				   wcss->desc->pasid, pd_asid,
+				    wcss->mem_region, wcss->mem_phys,
+				    wcss->mem_size, NULL);
+	release_firmware(firmware);
+	if (ret)
+		goto unlock;
+
+	ret = wcss_userpd_check(rproc, wcss, root_generation);
+	if (ret)
+		goto unlock;
+
+	pasid = (pd_asid << 8) | UPD_SWID;
+	dev_info(wcss->dev,
+		 "rd03v2 userpd trace: MSA lock asid=%u generation=%u\n",
+		 pd_asid, wcss->boot_generation);
+	if (!wcss->userpd_msa_unsupported)
+		ret = qcom_scm_msa_lock(pasid);
+	if (!ret)
+		ret = wcss_userpd_check(rproc, wcss, root_generation);
+
+unlock:
+	mutex_unlock(&rproc->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_wcss_userpd_prepare);
+
+int qcom_wcss_userpd_root_alive(struct rproc *rproc, u32 root_generation)
+{
+	struct wcss_sec *wcss;
+	int ret;
+
+	if (!rproc || !root_generation)
+		return -EINVAL;
+
+	mutex_lock(&rproc->lock);
+	wcss = rproc->priv;
+	ret = wcss_userpd_check(rproc, wcss, root_generation);
+	mutex_unlock(&rproc->lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_wcss_userpd_root_alive);
+
 static int wcss_sec_stop(struct rproc *rproc)
 {
 	struct wcss_sec *wcss = rproc->priv;
--- a/drivers/soc/qcom/mdt_loader.c
+++ b/drivers/soc/qcom/mdt_loader.c
@@ -18,6 +18,8 @@
 #include <linux/slab.h>
 #include <linux/soc/qcom/mdt_loader.h>
 
+#define QCOM_MDT_PF_ASID_MASK	GENMASK(19, 16)
+
 static bool mdt_header_valid(const struct firmware *fw)
 {
 	const struct elf32_hdr *ehdr;
@@ -31,6 +33,9 @@
 
 	if (memcmp(ehdr->e_ident, ELFMAG, SELFMAG))
 		return false;
+	if (ehdr->e_ident[EI_CLASS] != ELFCLASS32 ||
+	    ehdr->e_ident[EI_DATA] != ELFDATA2LSB)
+		return false;
 
 	if (ehdr->e_phentsize != sizeof(struct elf32_phdr))
 		return false;
@@ -100,6 +105,41 @@
 	return ret;
 }
 
+static int mdt_load_split_segment_dma(int pas_id, unsigned int segment,
+				      const struct firmware *fw, bool is_split,
+				      const struct elf32_phdr *phdrs,
+				      const char *fw_name,
+				      struct device *dev)
+{
+	const struct elf32_phdr *phdr = &phdrs[segment];
+	void *data;
+	int ret;
+
+	data = kvmalloc(phdr->p_filesz, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	if (is_split) {
+		ret = mdt_load_split_segment(data, phdrs, segment, fw_name, dev);
+		if (ret)
+			goto free_data;
+	} else {
+		if (phdr->p_offset > fw->size ||
+		    phdr->p_filesz > fw->size - phdr->p_offset) {
+			ret = -EINVAL;
+			goto free_data;
+		}
+		memcpy(data, fw->data + phdr->p_offset, phdr->p_filesz);
+	}
+
+	ret = qcom_scm_pas_load_segment(pas_id, segment, data,
+					phdr->p_filesz);
+
+free_data:
+	kvfree(data);
+	return ret;
+}
+
 /**
  * qcom_mdt_get_size() - acquire size of the memory region needed to load mdt
  * @fw:		firmware object for the mdt file
@@ -335,7 +375,8 @@
 static int __qcom_mdt_load(struct device *dev, const struct firmware *fw,
 			   const char *fw_name, void *mem_region,
 			   phys_addr_t mem_phys, size_t mem_size,
-			   phys_addr_t *reloc_base)
+			   phys_addr_t *reloc_base, bool dma_required,
+			   int pas_id, int pd_asid)
 {
 	const struct elf32_phdr *phdrs;
 	const struct elf32_phdr *phdr;
@@ -347,6 +388,8 @@
 	bool is_split;
 	void *ptr;
 	int ret = 0;
+	int matching = 0;
+	int loaded = 0;
 	int i;
 
 	if (!fw || !mem_region || !mem_phys || !mem_size)
@@ -392,8 +435,16 @@
 		if (!mdt_phdr_loadable(phdr))
 			continue;
 
+		if (pd_asid &&
+		    (FIELD_GET(QCOM_MDT_PF_ASID_MASK, phdr->p_flags) != pd_asid ||
+		     !(phdr->p_flags & PF_W)))
+			continue;
+		if (pd_asid)
+			matching++;
+
 		offset = phdr->p_paddr - mem_reloc;
-		if (offset < 0 || offset + phdr->p_memsz > mem_size) {
+		if (offset < 0 || (size_t)offset > mem_size ||
+		    phdr->p_memsz > mem_size - (size_t)offset) {
 			dev_err(dev, "segment outside memory range\n");
 			ret = -EINVAL;
 			break;
@@ -409,9 +460,19 @@
 
 		ptr = mem_region + offset;
 
-		if (phdr->p_filesz && !is_split) {
+		if (dma_required && phdr->p_filesz) {
+			ret = mdt_load_split_segment_dma(pas_id, i, fw, is_split,
+							 phdrs, fw_name, dev);
+			if (ret)
+				break;
+			loaded++;
+			dev_info(dev,
+				 "rd03v2 userpd trace: secure reload asid=%d segment=%d bytes=%u\n",
+				 pd_asid, i, phdr->p_filesz);
+		} else if (phdr->p_filesz && !is_split) {
 			/* Firmware is large enough to be non-split */
-			if (phdr->p_offset + phdr->p_filesz > fw->size) {
+			if (phdr->p_offset > fw->size ||
+			    phdr->p_filesz > fw->size - phdr->p_offset) {
 				dev_err(dev, "file %s segment %d would be truncated\n",
 					fw_name, i);
 				ret = -EINVAL;
@@ -426,12 +487,14 @@
 				break;
 		}
 
-		if (phdr->p_memsz > phdr->p_filesz)
+		if (!dma_required && phdr->p_memsz > phdr->p_filesz)
 			memset(ptr + phdr->p_filesz, 0, phdr->p_memsz - phdr->p_filesz);
 	}
 
 	if (reloc_base)
 		*reloc_base = mem_reloc;
+	if (!ret && pd_asid && (!matching || !loaded))
+		ret = -ENOENT;
 
 	return ret;
 }
@@ -461,7 +524,7 @@
 		return ret;
 
 	return __qcom_mdt_load(dev, fw, firmware, mem_region, mem_phys,
-			       mem_size, reloc_base);
+			       mem_size, reloc_base, false, pas_id, 0);
 }
 EXPORT_SYMBOL_GPL(qcom_mdt_load);
 
@@ -482,9 +545,22 @@
 			  size_t mem_size, phys_addr_t *reloc_base)
 {
 	return __qcom_mdt_load(dev, fw, firmware, mem_region, mem_phys,
-			       mem_size, reloc_base);
+			       mem_size, reloc_base, false, 0, 0);
 }
 EXPORT_SYMBOL_GPL(qcom_mdt_load_no_init);
 
+int qcom_mdt_load_pd_seg(struct device *dev, const struct firmware *fw,
+			 const char *firmware, int pas_id, int pd_asid,
+			 void *mem_region, phys_addr_t mem_phys, size_t mem_size,
+			 phys_addr_t *reloc_base)
+{
+	if (pd_asid <= 0 || pd_asid > FIELD_MAX(QCOM_MDT_PF_ASID_MASK))
+		return -EINVAL;
+
+	return __qcom_mdt_load(dev, fw, firmware, mem_region, mem_phys,
+			       mem_size, reloc_base, true, pas_id, pd_asid);
+}
+EXPORT_SYMBOL_GPL(qcom_mdt_load_pd_seg);
