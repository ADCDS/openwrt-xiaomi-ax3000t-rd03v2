From: Adriel Santos <adriel@adriel.eu>
Subject: [PATCH] wifi: mac80211: report pending ack frames when the hardware goes away

Frames sent through nl80211 with a wait -- hostapd's deauth and disassoc, for
instance -- are kept in local->ack_status_frames until the driver reports their
TX status. When the radio's firmware dies, no status ever arrives: the frames
are abandoned and ieee80211_free_hw() finds them still queued.

  ath11k c000000.wifi: failed to receive recovery response completion
  Have pending ack frames!
  WARNING: CPU: 0 PID: 9612 at net/mac80211/main.c:1716
    ieee80211_free_ack_frame+0x58/0x60 [mac80211]
    ieee80211_free_hw+0x30/0x470 [mac80211]
    ath11k_mac_destroy+0x50/0x84 [ath11k]
    ath11k_core_deinit+0x124/0x180 [ath11k]
    ath11k_ahb_remove+0x78/0xc0 [ath11k_ahb]

The frames are not leaked -- the WARN path frees them -- but the nl80211
waiters are left to time out on their own, and the warning fires on a teardown
that is otherwise clean. A driver that drops a frame itself already releases it
through ieee80211_free_txskb(); this adds the same report for whatever is still
queued in mac80211 when the hardware is unregistered, and then there is nothing
left for ieee80211_free_hw() to warn about.

Measured on the RD03v2 bench: an induced Q6 assert followed by the watchdog's
driver reload produced the warning above on every run; a healthy wifi-down plus
rmmod/modprobe produced none, so this is the crash path only.

Signed-off-by: Adriel Santos <adriel@adriel.eu>
---
--- a/net/mac80211/status.c
+++ b/net/mac80211/status.c
@@ -605,21 +605,19 @@
 	return NULL;
 }
 
-static void ieee80211_report_ack_skb(struct ieee80211_local *local,
-				     struct sk_buff *orig_skb,
-				     bool acked, bool dropped,
-				     ktime_t ack_hwtstamp)
+/*
+ * Report the ack status of one stored frame and free it. @orig_skb is the frame
+ * the driver was handed and @skb the copy kept for the report; they are the
+ * same buffer on the last-resort path below, where nothing will report status
+ * any more.
+ */
+static void ieee80211_report_ack_skb_now(struct ieee80211_local *local,
+					 struct sk_buff *orig_skb,
+					 struct sk_buff *skb,
+					 bool acked, bool dropped,
+					 ktime_t ack_hwtstamp)
 {
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(orig_skb);
-	struct sk_buff *skb;
-	unsigned long flags;
-
-	spin_lock_irqsave(&local->ack_status_lock, flags);
-	skb = idr_remove(&local->ack_status_frames, info->status_data);
-	spin_unlock_irqrestore(&local->ack_status_lock, flags);
-
-	if (!skb)
-		return;
 
 	if (info->flags & IEEE80211_TX_INTFL_NL80211_FRAME_TX) {
 		u64 cookie = IEEE80211_SKB_CB(skb)->ack.cookie;
@@ -677,6 +675,56 @@
 	}
 }
 
+static void ieee80211_report_ack_skb(struct ieee80211_local *local,
+				     struct sk_buff *orig_skb,
+				     bool acked, bool dropped,
+				     ktime_t ack_hwtstamp)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(orig_skb);
+	struct sk_buff *skb;
+	unsigned long flags;
+
+	spin_lock_irqsave(&local->ack_status_lock, flags);
+	skb = idr_remove(&local->ack_status_frames, info->status_data);
+	spin_unlock_irqrestore(&local->ack_status_lock, flags);
+
+	if (!skb)
+		return;
+
+	ieee80211_report_ack_skb_now(local, orig_skb, skb, acked, dropped,
+				     ack_hwtstamp);
+}
+
+/*
+ * Nothing will ever report status for the frames still waiting for one: the
+ * hardware is being unregistered, or its firmware died and the driver is being
+ * torn down. Report each as not acked so the nl80211 waiter is released and the
+ * skb is freed here, rather than left for ieee80211_free_hw() to find. A driver
+ * that drops a frame itself already does this through ieee80211_free_txskb();
+ * this catches whatever was still queued in mac80211 when the hardware went
+ * away.
+ */
+void ieee80211_report_pending_ack_frames(struct ieee80211_local *local)
+{
+	struct sk_buff *skb;
+	unsigned long flags;
+	int id = 0;
+
+	for (;;) {
+		spin_lock_irqsave(&local->ack_status_lock, flags);
+		skb = idr_get_next(&local->ack_status_frames, &id);
+		if (skb)
+			idr_remove(&local->ack_status_frames, id);
+		spin_unlock_irqrestore(&local->ack_status_lock, flags);
+
+		if (!skb)
+			break;
+
+		ieee80211_report_ack_skb_now(local, skb, skb, false, true, 0);
+		id++;
+	}
+}
+
 static void ieee80211_handle_smps_status(struct ieee80211_sub_if_data *sdata,
 					 bool acked, u16 status_data)
 {
--- a/net/mac80211/main.c
+++ b/net/mac80211/main.c
@@ -1696,6 +1696,7 @@
 	cancel_work_sync(&local->restart_work);
 
 	ieee80211_clear_tx_pending(local);
+	ieee80211_report_pending_ack_frames(local);
 	rate_control_deinitialize(local);
 
 	if (skb_queue_len(&local->skb_queue) ||
--- a/net/mac80211/ieee80211_i.h
+++ b/net/mac80211/ieee80211_i.h
@@ -2158,6 +2158,7 @@
 
 /* tx handling */
 void ieee80211_clear_tx_pending(struct ieee80211_local *local);
+void ieee80211_report_pending_ack_frames(struct ieee80211_local *local);
 void ieee80211_tx_pending(struct tasklet_struct *t);
 netdev_tx_t ieee80211_monitor_start_xmit(struct sk_buff *skb,
 					 struct net_device *dev);
