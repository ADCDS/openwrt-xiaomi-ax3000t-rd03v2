From: Adriel Santos <adriel@adriel.eu>
Subject: [PATCH] wifi: ath11k: ahb: respawn the user PDs when the root PD restarts

On IPQ5018 the radios run in user PDs that ath11k spawns itself over SMP2P
on the Q6 root PD. When the root PD restarts, the user PDs it hosted are
gone and nothing spawns them again:

- after a fatal error the remoteproc core recovers the root PD within a few
  seconds (with coredump disabled), but both radios stay down until ath11k is
  reloaded;
- a user PD restart (ath11k_core_reset(), e.g. simulate_fw_crash hw-restart)
  stops the PD and spawns it again on the root that ran it, which takes the
  root down: an exception in the root PD's kernel about 150 ms after the
  spawn ack on RD03v2 (WLAN.HK.2.7.0.1-01744). Reloading the PD's writable
  segments through the secure loader first only moves the fault into the
  reloaded PD, about 12 s later.

What works is what a driver reload does: a fresh root PD, the M3 images
loaded while it is down, then the user PDs spawned on it. Do that in place:

- The SSR notifier counts the root PD's stops (root_gen). AFTER_SHUTDOWN
  loads the M3 images again, the region being released; AFTER_POWERUP queues
  a respawn of every user PD ath11k had up and that is not running on the new
  root.
- The respawn work powers the PD down without the stop handshake (the
  firmware that would answer it is gone) and spawns it as at probe. ath11k's
  crash path, QMI server exit and arrival, rebuilds the radio from there, and
  the stations rejoin (patch 960).
- A user PD that was stopped with a stop handshake on a root PD that is still
  running restarts the root PD before it is spawned again; the other radio is
  respawned by the notifier.
- The stop handshake is skipped for a PD the running root never spawned.
  Completions are rearmed before each spawn and stop.
- respawn_userpds (default on) turns this off; respawn_max_per_hour (default
  6, as v1.x's qcom_q6v5_mpd) leaves the radios down after repeated root PD
  crashes and logs "user PD respawn suppressed after repeated root PD
  crashes", which the RD03v2 watchdog acts on. Restarts ath11k asks for are
  not counted.

This is v1.x's qcom_q6v5_mpd respawn (patch 0823) done where this tree
manages the user PDs, in ath11k.

Signed-off-by: Adriel Santos <adriel@adriel.eu>
---
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -72,6 +72,29 @@ MODULE_DEVICE_TABLE(of, ath11k_ahb_of_match);
 static struct ath11k_ahb_rproc_info *g_rproc_info;
 static DEFINE_MUTEX(ath11k_rproc_info_lock);
 
+/*
+ * When the Q6 root PD restarts - after a fatal error, which the remoteproc
+ * core recovers by itself, or because a user PD has to restart - the user
+ * PDs it hosted are gone, and nothing spawns them again: the radios stay
+ * down until the driver is reloaded. With respawn_userpds, ath11k spawns
+ * them again on the new root PD, and a user PD restart (hw-restart) restarts
+ * the root PD first: spawning a user PD again on the root that ran it before
+ * takes the root down (RD03v2: an exception in the root's kernel ~150 ms
+ * after the spawn ack). The radios then recover through the usual crash
+ * path, without a driver reload.
+ */
+static bool respawn_userpds = true;
+module_param(respawn_userpds, bool, 0644);
+MODULE_PARM_DESC(respawn_userpds,
+		 "Spawn the user PDs again when the root PD restarts, and restart the root PD to restart a user PD (default: true)");
+
+static unsigned int respawn_max_per_hour = 6;
+module_param(respawn_max_per_hour, uint, 0644);
+MODULE_PARM_DESC(respawn_max_per_hour,
+		 "Root PD crashes per hour after which the user PDs are left down (0: no limit; default: 6)");
+
+static void ath11k_ahb_reload_m3(struct ath11k_ahb_rproc_info *ri);
+
 static const char *irq_name[ATH11K_IRQ_NUM_MAX] = {
 	"misc-pulse1",
 	"misc-latch",
@@ -459,6 +482,10 @@ static int ath11k_ahb_boot_user_pd(struct ath11k_base *ab)
 		}
 	}
 
+	/* an ack left over from an earlier spawn must not end the waits below */
+	reinit_completion(&ab_ahb->userpd_spawned);
+	reinit_completion(&ab_ahb->userpd_ready);
+
 	ret = qcom_smem_state_update_bits(ab_ahb->spawn_state, BIT(ab_ahb->spawn_bit),
 					  BIT(ab_ahb->spawn_bit));
 	if (ret) {
@@ -482,11 +509,67 @@ static int ath11k_ahb_boot_user_pd(struct ath11k_base *ab)
 
 	qcom_smem_state_update_bits(ab_ahb->spawn_state, BIT(ab_ahb->spawn_bit), 0);
 
+	if (ab_ahb->rproc_info)
+		ab_ahb->spawned_gen = READ_ONCE(ab_ahb->rproc_info->root_gen);
+
 	ath11k_dbg(ab, ATH11K_DBG_AHB, "UserPD%d is now UP\n", ab_ahb->userpd_id);
 
 	return 0;
 }
 
+/*
+ * Restart the root PD, for a user PD that was stopped on it: the root that ran
+ * a user PD does not run it again. Our boot reference must be the only one, or
+ * rproc_shutdown() would not stop it. The SSR notifier reloads the M3 images
+ * while the root is down and queues the respawn of the other user PDs once it
+ * is up; this one is spawned by the caller.
+ */
+static int ath11k_ahb_restart_root_pd(struct ath11k_base *ab)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	struct ath11k_ahb_rproc_info *ri = ab_ahb->rproc_info;
+	struct rproc *rproc = ri->tgt_rproc;
+	u32 gen = READ_ONCE(ri->root_gen);
+	unsigned long left;
+	int ret;
+
+	lockdep_assert_held(&ri->userpd_lock);
+
+	if (rproc->state != RPROC_RUNNING || atomic_read(&rproc->power) != 1) {
+		ath11k_err(ab, "UserPD%d: cannot restart the root PD (state %d, users %d)\n",
+			   ab_ahb->userpd_id, rproc->state, atomic_read(&rproc->power));
+		return -EBUSY;
+	}
+
+	ath11k_info(ab, "UserPD%d was stopped on a running root PD; restarting the root PD\n",
+		    ab_ahb->userpd_id);
+	WRITE_ONCE(ri->planned_restart, true);
+	ret = rproc_shutdown(rproc);
+	if (ret) {
+		ath11k_err(ab, "failed to stop the root PD: %d\n", ret);
+		goto out;
+	}
+
+	reinit_completion(&ri->rootpd_ready);
+	ret = rproc_boot(rproc);
+	if (ret) {
+		ath11k_err(ab, "failed to restart the root PD: %d\n", ret);
+		goto out;
+	}
+
+	left = wait_for_completion_timeout(&ri->rootpd_ready, ATH11K_ROOTPD_READY_TIMEOUT);
+	if (!left) {
+		ath11k_err(ab, "root PD ready wait timed out after its restart\n");
+		ret = -ETIMEDOUT;
+	} else if (READ_ONCE(ri->root_gen) == gen) {
+		ath11k_err(ab, "the root PD did not restart\n");
+		ret = -EIO;
+	}
+out:
+	WRITE_ONCE(ri->planned_restart, false);
+	return ret;
+}
+
 static int ath11k_ahb_power_up(struct ath11k_base *ab)
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
@@ -494,7 +577,17 @@ static int ath11k_ahb_power_up(struct ath11k_base *ab)
 
 	if (ab_ahb->userpd_id > 0 &&
 	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX) {
-		ret = ath11k_ahb_boot_user_pd(ab);
+		struct ath11k_ahb_rproc_info *ri = ab_ahb->rproc_info;
+
+		mutex_lock(&ri->userpd_lock);
+		ab_ahb->userpd_wanted = true;
+		ret = 0;
+		if (respawn_userpds && ab_ahb->stopped_on_gen &&
+		    ab_ahb->stopped_on_gen == READ_ONCE(ri->root_gen))
+			ret = ath11k_ahb_restart_root_pd(ab);
+		if (!ret)
+			ret = ath11k_ahb_boot_user_pd(ab);
+		mutex_unlock(&ri->userpd_lock);
 		if (ret) {
 			ath11k_err(ab, "failed to boot userPD%d: %d\n",
 				   ab_ahb->userpd_id, ret);
@@ -508,8 +601,11 @@ static int ath11k_ahb_power_up(struct ath11k_base *ab)
 static void ath11k_ahb_stop_user_pd(struct ath11k_base *ab)
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	struct ath11k_ahb_rproc_info *ri = ab_ahb->rproc_info;
 	unsigned long time_left;
 
+	ab_ahb->stopped_on_gen = 0;
+
 	/*
 	 * The stop request is an SMP2P handshake that the firmware which
 	 * spawned this user PD answers. After a fatal error on the Q6 that
@@ -524,6 +620,14 @@ static void ath11k_ahb_stop_user_pd(struct ath11k_base *ab)
 		goto power_off;
 	}
 
+	/* the same for a PD the running root never spawned: it restarted since */
+	if (ri && ab_ahb->spawned_gen != READ_ONCE(ri->root_gen)) {
+		ath11k_info(ab, "UserPD%d: not running on this root PD, skipping the stop handshake\n",
+			    ab_ahb->userpd_id);
+		goto power_off;
+	}
+
+	reinit_completion(&ab_ahb->userpd_stopped);
 	qcom_smem_state_update_bits(ab_ahb->stop_state, BIT(ab_ahb->stop_bit),
 				    BIT(ab_ahb->stop_bit));
 
@@ -531,10 +635,13 @@ static void ath11k_ahb_stop_user_pd(struct ath11k_base *ab)
 						ATH11K_USERPD_STOP_TIMEOUT);
 	if (!time_left)
 		ath11k_warn(ab, "UserPD stop wait timed out\n");
+	else if (ri)
+		ab_ahb->stopped_on_gen = READ_ONCE(ri->root_gen);
 
 	qcom_smem_state_update_bits(ab_ahb->stop_state, BIT(ab_ahb->stop_bit), 0);
 
 power_off:
+	ab_ahb->spawned_gen = 0;
 	if (ab->hw_rev == ATH11K_HW_IPQ5018_HW10)
 		qcom_scm_pas_set_wifi_power_mode(MPD_WCNSS_PAS_ID, false);
 }
@@ -544,8 +651,101 @@ static void ath11k_ahb_power_down(struct ath11k_base *ab, bool is_suspend)
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 
 	if (ab_ahb->userpd_id > 0 &&
-	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX)
+	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX) {
+		mutex_lock(&ab_ahb->rproc_info->userpd_lock);
+		ab_ahb->userpd_wanted = false;
 		ath11k_ahb_stop_user_pd(ab);
+		mutex_unlock(&ab_ahb->rproc_info->userpd_lock);
+	}
+}
+
+/*
+ * Spawn a user PD again on a root PD that restarted under it. The firmware
+ * that ran it is gone with the old root, so it is powered down without the
+ * stop handshake and spawned like at probe; ath11k's crash path (QMI server
+ * exit, then arrival) rebuilds the radio from there.
+ */
+static void ath11k_ahb_respawn_work(struct work_struct *work)
+{
+	struct ath11k_ahb *ab_ahb = container_of(work, struct ath11k_ahb, respawn_work);
+	struct ath11k_base *ab = ab_ahb->ab;
+	struct ath11k_ahb_rproc_info *ri = ab_ahb->rproc_info;
+	int ret;
+
+	if (!ri)
+		return;
+
+	mutex_lock(&ri->userpd_lock);
+	if (!ab_ahb->userpd_wanted ||
+	    test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags) ||
+	    ab_ahb->spawned_gen == READ_ONCE(ri->root_gen) ||
+	    ri->tgt_rproc->state != RPROC_RUNNING)
+		goto unlock;
+
+	ath11k_info(ab, "UserPD%d: the root PD restarted, spawning it again\n",
+		    ab_ahb->userpd_id);
+	ath11k_ahb_stop_user_pd(ab);
+	ret = ath11k_ahb_boot_user_pd(ab);
+	if (ret)
+		ath11k_err(ab, "UserPD%d: respawn failed: %d\n", ab_ahb->userpd_id, ret);
+	else
+		ath11k_info(ab, "UserPD%d: respawned\n", ab_ahb->userpd_id);
+unlock:
+	mutex_unlock(&ri->userpd_lock);
+}
+
+/* A root PD crash loop must end: leave the radios down after too many. */
+static bool ath11k_ahb_respawn_allowed(struct ath11k_ahb_rproc_info *ri)
+{
+	unsigned int max = min_t(unsigned int, respawn_max_per_hour,
+				 ATH11K_AHB_RESPAWN_HISTORY);
+	unsigned int i, recent = 0;
+
+	if (!respawn_max_per_hour)
+		return true;
+
+	for (i = 0; i < ATH11K_AHB_RESPAWN_HISTORY; i++)
+		if (ri->respawn_at[i] &&
+		    time_before(jiffies, ri->respawn_at[i] + 3600 * HZ))
+			recent++;
+	if (recent >= max) {
+		pr_warn("ath11k_ahb: user PD respawn suppressed after repeated root PD crashes (%u in the last hour)\n",
+			recent);
+		return false;
+	}
+
+	ri->respawn_at[ri->respawn_next] = jiffies ? jiffies : 1;
+	ri->respawn_next = (ri->respawn_next + 1) % ATH11K_AHB_RESPAWN_HISTORY;
+	return true;
+}
+
+static void ath11k_ahb_queue_respawn(struct ath11k_ahb_rproc_info *ri)
+{
+	struct ath11k_ahb *ab_ahb;
+	unsigned long flags;
+	bool due[ATH11K_AHB_USERPD_ID_MAX] = {};
+	bool any = false;
+	u32 gen = READ_ONCE(ri->root_gen);
+	int i;
+
+	if (!respawn_userpds)
+		return;
+
+	spin_lock_irqsave(&ri->userpd_list_lock, flags);
+	for (i = 0; i < ATH11K_AHB_USERPD_ID_MAX; i++) {
+		ab_ahb = ri->userpd[i];
+		due[i] = ab_ahb && READ_ONCE(ab_ahb->userpd_wanted) &&
+			 ab_ahb->spawned_gen != gen;
+		any |= due[i];
+	}
+	/* a restart ath11k asked for is not a crash */
+	if (any && !READ_ONCE(ri->planned_restart) &&
+	    !ath11k_ahb_respawn_allowed(ri))
+		any = false;
+	for (i = 0; any && i < ATH11K_AHB_USERPD_ID_MAX; i++)
+		if (due[i])
+			queue_work(system_long_wq, &ri->userpd[i]->respawn_work);
+	spin_unlock_irqrestore(&ri->userpd_list_lock, flags);
 }
 
 static void ath11k_ahb_init_qmi_ce_config(struct ath11k_base *ab)
@@ -1011,7 +1211,10 @@ static int ath11k_ahb_init_userpd(struct ath11k_base *ab, int userpd_id)
 		return -EINVAL;
 	}
 
+	INIT_WORK(&ab_ahb->respawn_work, ath11k_ahb_respawn_work);
+	spin_lock_irq(&g_rproc_info->userpd_list_lock);
 	g_rproc_info->userpd[userpd_id - 1] = ab_ahb;
+	spin_unlock_irq(&g_rproc_info->userpd_list_lock);
 	g_rproc_info->num_userpd++;
 
 	return 0;
@@ -1047,8 +1250,13 @@ static void ath11k_ahb_cleanup_userpd(struct ath11k_base *ab)
 		return;
 
 	if (rproc_info && ab_ahb->userpd_id > 0 &&
-	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX) {
+	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX &&
+	    rproc_info->userpd[ab_ahb->userpd_id - 1] == ab_ahb) {
+		/* out of the notifier's sight first, then no work may be left */
+		spin_lock_irq(&rproc_info->userpd_list_lock);
 		rproc_info->userpd[ab_ahb->userpd_id - 1] = NULL;
+		spin_unlock_irq(&rproc_info->userpd_list_lock);
+		cancel_work_sync(&ab_ahb->respawn_work);
 		rproc_info->num_userpd--;
 		ab_ahb->rproc_info = NULL;
 	}
@@ -1120,9 +1328,16 @@ static int ath11k_ahb_root_pd_state_notifier(struct notifier_block *nb,
 	struct ath11k_ahb_rproc_info *rproc_info =
 		container_of(nb, struct ath11k_ahb_rproc_info, root_pd_nb);
 
-	if (event == ATH11K_RPROC_AFTER_POWERUP) {
+	switch (event) {
+	case ATH11K_RPROC_AFTER_SHUTDOWN:
+		WRITE_ONCE(rproc_info->root_gen, rproc_info->root_gen + 1);
+		ath11k_ahb_reload_m3(rproc_info);
+		break;
+	case ATH11K_RPROC_AFTER_POWERUP:
 		ath11k_dbg(NULL, ATH11K_DBG_AHB, "Root PD is UP\n");
 		complete(&rproc_info->rootpd_ready);
+		ath11k_ahb_queue_respawn(rproc_info);
+		break;
 	}
 
 	return 0;
@@ -1175,6 +1390,9 @@ static struct ath11k_ahb_rproc_info *ath11k_ahb_rproc_info_alloc(struct ath11k_b
 
 	rproc_info->root_pd_booted = false;
 	rproc_info->m3_loaded = 0;
+	rproc_info->root_gen = 1;
+	mutex_init(&rproc_info->userpd_lock);
+	spin_lock_init(&rproc_info->userpd_list_lock);
 	init_completion(&rproc_info->rootpd_ready);
 	ab_ahb->rproc_info = rproc_info;
 
@@ -1272,7 +1490,12 @@ static int ath11k_ahb_load_m3_firmware(struct ath11k_base *ab)
 
 	mem_phys = res.start;
 	mem_size = resource_size(&res);
-	mem_region = devm_memremap(ab->dev, mem_phys, mem_size, MEMREMAP_WC);
+	/* not devm: this runs again after every root PD stop */
+	mem_region = memremap(mem_phys, mem_size, MEMREMAP_WC);
+	if (!mem_region) {
+		ath11k_err(ab, "Failed to map the m3 memory region\n");
+		return -ENOMEM;
+	}
 
 	snprintf(m3_fw_name, sizeof(m3_fw_name), "%s/%s/%s",
 		 ATH11K_FW_DIR, ab->hw_params.fw.dir, ATH11K_M3_MBN_FILE);
@@ -1280,13 +1503,13 @@ static int ath11k_ahb_load_m3_firmware(struct ath11k_base *ab)
 	ret = request_firmware(&m3_fw, m3_fw_name, ab->dev);
 	if (ret < 0) {
 		ath11k_err(ab, "Failed to request firmware: %d\n", ret);
-		return ret;
+		goto unmap;
 	}
 
 	if (!m3_fw->size || m3_fw->size > mem_size) {
 		ath11k_err(ab, "Invalid firmware size\n");
-		release_firmware(m3_fw);
-		return -EINVAL;
+		ret = -EINVAL;
+		goto release;
 	}
 
 	ret = qcom_mdt_load_no_init(ab->dev, m3_fw, m3_fw_name, mem_region,
@@ -1294,11 +1517,48 @@ static int ath11k_ahb_load_m3_firmware(struct ath11k_base *ab)
 	if (ret)
 		ath11k_err(ab, "Failed to load MDT segments: %d\n", ret);
 
+release:
 	release_firmware(m3_fw);
+unmap:
+	memunmap(mem_region);
 
 	return ret;
 }
 
+/*
+ * The M3 images live in the root PD's memory region and are written by the
+ * host, which may only do so while the root PD is down - a host write there
+ * while it runs resets the board. ath11k loads them before its first root PD
+ * boot; after a root PD stop (AFTER_SHUTDOWN, the region is released) load
+ * them again, as a driver reload would, for the respawn that follows.
+ */
+static void ath11k_ahb_reload_m3(struct ath11k_ahb_rproc_info *ri)
+{
+	struct ath11k_base *abs[ATH11K_AHB_USERPD_ID_MAX];
+	unsigned long flags;
+	u32 done = 0;
+	int i, n = 0, ret;
+
+	spin_lock_irqsave(&ri->userpd_list_lock, flags);
+	for (i = 0; i < ATH11K_AHB_USERPD_ID_MAX; i++)
+		if (ri->userpd[i])
+			abs[n++] = ri->userpd[i]->ab;
+	spin_unlock_irqrestore(&ri->userpd_list_lock, flags);
+
+	for (i = 0; i < n; i++) {
+		u32 bit = BIT(abs[i]->hw_params.hw_rev);
+
+		if (!(ri->m3_loaded & bit) || (done & bit))
+			continue;
+		ret = ath11k_ahb_load_m3_firmware(abs[i]);
+		if (ret)
+			ath11k_err(abs[i], "failed to reload m3 firmware: %d\n", ret);
+		else
+			ath11k_dbg(abs[i], ATH11K_DBG_AHB, "m3 firmware reloaded\n");
+		done |= bit;
+	}
+}
+
 static int ath11k_ahb_configure_rproc(struct ath11k_base *ab)
 {
 	int ret;
@@ -1694,6 +1954,19 @@ static int ath11k_ahb_fw_resource_deinit(struct ath11k_base *ab)
 
 static void ath11k_ahb_remove_prepare(struct ath11k_base *ab);
 
+/* No respawn may start once the device is going away. */
+static void ath11k_ahb_stop_respawn(struct ath11k_base *ab)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+
+	if (!ab_ahb->rproc_info || ab_ahb->userpd_id < 1 ||
+	    ab_ahb->userpd_id >= ATH11K_AHB_USERPD_ID_MAX)
+		return;
+
+	WRITE_ONCE(ab_ahb->userpd_wanted, false);
+	cancel_work_sync(&ab_ahb->respawn_work);
+}
+
 static int ath11k_ahb_probe(struct platform_device *pdev)
 {
 	struct ath11k_base *ab;
@@ -1851,6 +2124,7 @@ static void ath11k_ahb_remove_prepare(struct ath11k_base *ab)
 	}
 
 	set_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags);
+	ath11k_ahb_stop_respawn(ab);
 	cancel_work_sync(&ab->restart_work);
 	cancel_work_sync(&ab->qmi.event_work);
 	cancel_work_sync(&ab->wmi_ast_work);
--- a/drivers/net/wireless/ath/ath11k/ahb.h
+++ b/drivers/net/wireless/ath/ath11k/ahb.h
@@ -18,6 +18,8 @@
 
 #define ATH11K_ROOTPD_READY_TIMEOUT		(5 * HZ)
 #define ATH11K_RPROC_AFTER_POWERUP		QCOM_SSR_AFTER_POWERUP
+#define ATH11K_RPROC_AFTER_SHUTDOWN		QCOM_SSR_AFTER_SHUTDOWN
+#define ATH11K_AHB_RESPAWN_HISTORY		32
 
 #define ATH11K_USERPD_SPAWN_TIMEOUT		(5 * HZ)
 #define ATH11K_USERPD_READY_TIMEOUT		(10 * HZ)
@@ -53,6 +55,21 @@ struct ath11k_ahb_rproc_info {
 
 	/* Bitmap of loaded M3 firmwares indexed by hardware revision */
 	u32 m3_loaded;
+
+	/*
+	 * User-PD respawn (see ath11k_ahb_respawn_work()). root_gen counts the
