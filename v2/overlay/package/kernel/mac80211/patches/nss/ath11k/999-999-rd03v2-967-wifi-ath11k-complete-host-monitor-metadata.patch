From: openwrt-xiaomi-ax3000t-rd03v2 port
Subject: [PATCH] wifi: ath11k: complete host monitor metadata at every default reset

Requesting USER_STATS alone did not populate host station RSSI on the bench.
The existing extended-statistics filter restored real RSSI and its average on
both radios. Use that measured metadata mask in host mode while leaving the
extended counter flag disabled. PPDU_START supplies per-PPDU identity/reset
state; firmware's grouping of the PHY RSSI TLVs is not visible to the host.

Keep the effective NSS mask unchanged, and apply the helper after every
default-filter restoration. No buffer or ring count is enlarged.
---
--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -226,6 +226,9 @@
 {
 	if (ab->nss.enabled)
 		tlv_filter->rx_filter |= HTT_RX_FILTER_TLV_FLAGS_PPDU_END_USER_STATS;
+	else
+		tlv_filter->rx_filter |= HTT_RX_FILTER_TLV_FLAGS_PPDU_START |
+			HTT_RX_FILTER_TLV_FLAGS_PPDU_END_USER_STATS_EXT;
 }
 
 static u32 ath11k_nss_cipher_type(struct ath11k_base *ab, u32 cipher)
--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -1446,6 +1446,7 @@
 					HTT_RX_MON_FILTER_TLV_FLAGS_MON_STATUS_RING;
 		} else {
 			tlv_filter = ath11k_mac_mon_status_filter_default;
+			ath11k_nss_ext_rx_stats(ab, &tlv_filter);
 
 			if (ath11k_debugfs_is_extd_rx_stats_enabled(ar))
 				tlv_filter.rx_filter = ath11k_debugfs_rx_filter(ar);
--- a/drivers/net/wireless/ath/ath11k/debugfs.c
+++ b/drivers/net/wireless/ath/ath11k/debugfs.c
@@ -886,8 +886,10 @@
 	int i;
 	u32 ring_id;
 
-	if (enable)
+	if (enable) {
 		tlv_filter = ath11k_mac_mon_status_filter_default;
+		ath11k_nss_ext_rx_stats(ab, &tlv_filter);
+	}
 
 	for (i = 0; i < ab->hw_params.num_rxdma_per_pdev; i++) {
 		ring_id = ar->dp.rx_mon_status_refill_ring[i].refill_buf_ring.ring_id;
@@ -1151,6 +1153,7 @@
 	} else {
 		rx_buf_sz = DP_RX_BUFFER_SIZE;
 		tlv_filter = ath11k_mac_mon_status_filter_default;
+		ath11k_nss_ext_rx_stats(ar->ab, &tlv_filter);
 		rx_filter = tlv_filter.rx_filter;
 
 		ret = ath11k_dp_tx_htt_h2t_ppdu_stats_req(ar,
