#!/bin/sh /etc/rc.common
# WiFi Q6 firmware death watchdog - issue #15; see /etc/config/rd03v2-watchdog
START=99
USE_PROCD=1

start_service() {
	[ "$(uci -q get rd03v2-watchdog.main.enabled)" = 0 ] && return 0
	procd_open_instance
	procd_set_param command /usr/sbin/rd03v2-watchdog
	procd_set_param respawn 3600 5 0
	# it reads the config once, at start: restart it when the file changes
	procd_set_param file /etc/config/rd03v2-watchdog
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rd03v2-watchdog
}
