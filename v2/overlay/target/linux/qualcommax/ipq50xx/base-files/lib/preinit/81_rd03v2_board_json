# An unclean reboot can leave /etc/board.json empty: wifi-detect.uc rewrites it (write, rename,
# no fsync) whenever a radio appears, and on UBIFS a crash before the data reaches flash keeps
# the rename but not the data. 82_config_generate only generates the file when it is missing,
# and wifi-detect.uc cannot parse an empty one, so the radios then stay down on every boot
# ("PHY is undefined") until the file is removed by hand. Measured on the bench after two crash
# reboots. Remove an empty or unreadable one here, after the overlay is mounted, so that
# 82_config_generate generates it again; wifi-detect adds the radios back when they appear.

rd03v2_board_json() {
	[ -f /etc/board.json ] || return 0
	[ -s /etc/board.json ] && jsonfilter -i /etc/board.json -e '@.model.id' >/dev/null 2>&1 && return 0
	echo "- /etc/board.json is empty or unreadable, generating it again -"
	rm -f /etc/board.json
}

boot_hook_add preinit_main rd03v2_board_json
