+/* Optional diagnostics: handler duration, not hardware IRQ scheduling latency. */
+static bool refill_diag;
+module_param(refill_diag, bool, 0644);
+MODULE_PARM_DESC(refill_diag, "Collect empty-buffer SOS diagnostics (default off)");
+
+static void nss_core_refill_diag(struct nss_ctx_instance *nss_ctx,
+		uint16_t slots, uint16_t submitted, u64 start)
+{
+	u64 elapsed = ktime_get_ns() - start;
+	unsigned int cpu = raw_smp_processor_id();
+	unsigned int bucket;
+
+	NSS_PKT_STATS_INC(&nss_ctx->nss_top->stats_drv[NSS_DRV_STATS_REFILL_CALLS]);
+	NSS_PKT_STATS_ADD(&nss_ctx->nss_top->stats_drv[NSS_DRV_STATS_REFILL_SLOTS], slots);
+	NSS_PKT_STATS_ADD(&nss_ctx->nss_top->stats_drv[NSS_DRV_STATS_REFILL_SUBMITTED], submitted);
+	if (!slots)
+		NSS_PKT_STATS_INC(&nss_ctx->nss_top->stats_drv[NSS_DRV_STATS_REFILL_ZERO_SLOTS]);
+	else if (submitted < slots)
+		NSS_PKT_STATS_INC(&nss_ctx->nss_top->stats_drv[NSS_DRV_STATS_REFILL_PARTIAL]);
+	if (cpu < 2)
+		NSS_PKT_STATS_INC(&nss_ctx->nss_top->stats_drv[NSS_DRV_STATS_REFILL_CPU0 + cpu]);
+	bucket = elapsed < 10000 ? NSS_DRV_STATS_REFILL_LT10US :
+		elapsed < 50000 ? NSS_DRV_STATS_REFILL_LT50US :
+		elapsed < 100000 ? NSS_DRV_STATS_REFILL_LT100US :
+		elapsed < 500000 ? NSS_DRV_STATS_REFILL_LT500US :
+		elapsed < 1000000 ? NSS_DRV_STATS_REFILL_LT1000US : NSS_DRV_STATS_REFILL_GE1000US;
+	NSS_PKT_STATS_INC(&nss_ctx->nss_top->stats_drv[bucket]);
+}
