@@ -180,6 +181,170 @@
 #endif
 }
 
+#ifdef ECM_BRIDGE_VLAN_FILTERING_ENABLE
+/*
+ * ecm_nss_common_vlan_filter_vid()
+ *	The 802.1Q VID ci->vlan_filter recorded for `dev` in the two entries
+ *	starting at `first`: 0 when neither names dev, -1 when the entry is not
+ *	a usable 802.1Q VID.
+ */
+static inline int ecm_nss_common_vlan_filter_vid(struct ecm_db_connection_instance *ci,
+						 struct net_device *dev, int first)
+{
+	struct ecm_db_connection_vlan_filter *vf;
+	int i;
+
+	for (i = first; i < first + ECM_VLAN_FILTER_RULE_IFACE_MAX; i++) {
+		vf = &ci->vlan_filter[i];
+		if (!vf->is_valid || !vf->ii ||
+		    ecm_db_iface_interface_identifier_get(vf->ii) != dev->ifindex) {
+			continue;
+		}
+		if (vf->vlan_tpid != ETH_P_8021Q || !vf->vlan_tag || vf->vlan_tag >= VLAN_N_VID) {
+			return -1;
+		}
+		return vf->vlan_tag;
+	}
+	return 0;
+}
+#endif
+
+/*
+ * ecm_nss_common_dsa_rule_vid_get()
+ *	The VID an NSS rule must carry on the conduit for the flow side whose
+ *	innermost interface is `dev`: 0 to leave that side untagged, -1 when the
+ *	connection must not be accelerated.
+ *
+ *	  - outside a VLAN-aware bridge: the tag_8021q VID from
+ *	    ecm_nss_common_dsa_8021q_vid_get();
+ *	  - a tag_8021q DSA user port of a VLAN-aware bridge: the bridge VLAN
+ *	    this connection uses on that port, whether the port itself sends
+ *	    it tagged or untagged. The CPU port is a tagged member of every
+ *	    bridge VLAN (999-2762), so the conduit carries that tag in both
+ *	    directions. ECM records the VLAN in ci->vlan_filter, but only the
+ *	    SFE frontend ever read it: NSS rules went out with no VLAN, frames
+ *	    from the switch kept their 802.1Q header through the NSS (most
+ *	    Wi-Fi clients drop those), and frames towards the switch fell into
+ *	    the CPU port's all-ports PVID.
+ *
+ *	The VLAN is taken only when both directions recorded the same VID for
+ *	dev: flow egress and return ingress for the 'to' side (to_side), flow
+ *	ingress and return egress for the 'from' side. They can disagree -
+ *	ecm_db_connection_add_vlan_filter() carries the VID found for one side
+ *	into the walk of the other, and br_fdb_find_vid_by_mac() returns the
+ *	newest FDB entry for a MAC in any VLAN - for example a routed flow through the
+ *	bridge master itself to a trunk port, or a host using one MAC on several
+ *	VLANs. A VLAN-aware port without an agreeing VID is refused (-1) rather
+ *	than left untagged, which would put it back in the all-ports PVID.
+ */
+static inline int ecm_nss_common_dsa_rule_vid_get(struct ecm_db_connection_instance *ci,
+						  struct net_device *dev, bool to_side)
+{
+	int vid = ecm_nss_common_dsa_8021q_vid_get(dev);
+#if IS_ENABLED(CONFIG_NET_DSA) && defined(ECM_BRIDGE_VLAN_FILTERING_ENABLE)
+	struct dsa_port *dp;
+	struct net_device *br;
+	int ret_vid;
+
+	if (vid || !dsa_user_dev_check(dev)) {
+		return vid;
+	}
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR_OR_NULL(dp) || !dp->ds->tag_8021q_ctx) {
+		return 0;
+	}
+
+	br = dsa_port_bridge_dev_get(dp);
+	if (!br || !br_vlan_enabled(br)) {
+		return 0;
+	}
+	if (!ci->vlan_filter_valid || !ci->vlan_filter) {
+		return -1;
+	}
+
+	if (to_side) {
+		vid = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_FLOW_EGRESS1);
+		ret_vid = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_RET_INGRESS1);
+	} else {
+		vid = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_FLOW_INGRESS1);
+		ret_vid = ecm_nss_common_vlan_filter_vid(ci, dev, ECM_VLAN_FILTER_RULE_RET_EGRESS1);
+	}
+	if (vid <= 0 || vid != ret_vid) {
+		return -1;
+	}
+#endif
+	return vid;
+}
+
+/*
+ * ecm_nss_common_bridge_vlan_side_untagged()
+ *	True when one flow side's primary VLAN tag came from a VLAN netdev on a
+ *	VLAN-filtering bridge (br-lan.N) while the innermost interface of that
+ *	side - the one the NSS really exchanges frames with - is a non-DSA
+ *	bridge port that is an UNTAGGED member of that VLAN, such as a Wi-Fi
+ *	VAP. Nothing on that side carries the tag, so a tag in the rule makes
+ *	the NSS forward frames with a shifted L2 header: routed Wi-Fi <-> WAN
+ *	traffic over br-lan.1 stalled as soon as ECM accelerated it.
+ *
+ *	DSA ports keep the stock behaviour: the conduit of a tag_8021q switch
+ *	carries the bridge VID even for untagged ports.
+ */
+static inline bool ecm_nss_common_bridge_vlan_side_untagged(struct ecm_db_iface_instance *ifaces[], int32_t first)
+{
+	struct bridge_vlan_info vinfo;
+	struct net_device *vdev;
+	struct net_device *port;
+	struct net_device *br;
+	bool untagged = false;
+	int32_t i;
+	u16 vid;
+
+	for (i = first + 1; i < ECM_DB_IFACE_HEIRARCHY_MAX; i++) {
+		if (ecm_db_iface_type_get(ifaces[i]) == ECM_DB_IFACE_TYPE_VLAN) {
+			break;
+		}
+	}
+	if (i >= ECM_DB_IFACE_HEIRARCHY_MAX) {
+		return false;
+	}
+
+	vdev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(ifaces[i]));
+	if (!vdev) {
+		return false;
+	}
+
+	port = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(ifaces[first]));
+	if (!port) {
+		dev_put(vdev);
+		return false;
+	}
+
+	rcu_read_lock();
+	if (!is_vlan_dev(vdev) || !netif_is_bridge_port(port)) {
+		goto out;
+	}
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (dsa_user_dev_check(port)) {
+		goto out;
+	}
+#endif
+	br = vlan_dev_real_dev(vdev);
+	vid = vlan_dev_vlan_id(vdev);
+	if (!netif_is_bridge_master(br) || !br_vlan_enabled(br) ||
+	    netdev_master_upper_dev_get_rcu(port) != br) {
+		goto out;
+	}
+	if (!br_vlan_get_info_rcu(port, vid, &vinfo)) {
+		untagged = !!(vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED);
+	}
+out:
+	rcu_read_unlock();
+	dev_put(port);
+	dev_put(vdev);
+	return untagged;
+}
+
