diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
index 7f3c7db25b..8f86da91c7 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
@@ -37,6 +37,13 @@ ipq50xx_setup_interfaces()
 		ucidef_set_network_device_conduit "lan3" "eth1"
 		ucidef_set_network_device_conduit "wan" "eth0"
 		;;
+	xiaomi,mi-router-ax3000t-v2)
+		# NSS offload gateway: user ports default to eth1 (2.5G CPU port); the
+		# WAN is moved to eth0 (1G CPU port) so WAN<->LAN routing is offloaded
+		# across the two CPU ports by the NSS firmware. See docs/nss-offload.md.
+		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"
+		ucidef_set_network_device_conduit "wan" "eth0"
+		;;
 	esac
 }
 
