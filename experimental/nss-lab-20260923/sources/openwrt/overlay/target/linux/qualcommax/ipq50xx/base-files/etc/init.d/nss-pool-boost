#!/bin/sh /etc/rc.common
# After the existing early Wi-Fi policy and S96 baseline pool setup.
START=97
STOP=10
USE_PROCD=1

start_service() {
    [ ! -e /etc/nss-pool-boost.failed ] || return 0
    procd_open_instance
    procd_set_param command /bin/sh /usr/sbin/nss-pool-boost-monitor
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ -w /proc/sys/dev/nss/n2hcfg/n2h_high_water_core0 ] || return 0
    echo 4096 > /proc/sys/dev/nss/n2hcfg/n2h_high_water_core0
}
