+
+static ssize_t ath11k_read_nss_stats_diag(struct file *file,
+                                         char __user *ubuf,
+                                         size_t count, loff_t *ppos)
+{
+    struct ath11k *ar = file->private_data;
+    struct ath11k_base *ab = ar->ab;
+    static const char * const names[] = {
+        "peer_events",
+        "peer_errors",
+        "entries",
+        "disabled_batches",
+        "lookup_miss",
+        "missing_sta",
+        "missing_stats",
+        "applied",
+        "tx_bytes",
+        "rx_bytes",
+        "cfg_sent",
+        "cfg_send_fail",
+        "cfg_ack",
+        "cfg_nack",
+        "cfg_last_error",
+        "last_peer",
+        "last_npeers",
+    };
+    char *buf;
+    int i, len = 0;
+    ssize_t ret;
+
+    buf = kzalloc(4096, GFP_KERNEL);
+    if (!buf)
+        return -ENOMEM;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+        len += scnprintf(buf + len, 4096 - len, "%s %lld\n", names[i],
+                         (long long)atomic64_read(&ab->nss.stats_diag[i]));
+    for (i = 0; i < ARRAY_SIZE(ab->nss.stats_events); i++) {
+        long long value = atomic64_read(&ab->nss.stats_events[i]);
+        if (value)
+            len += scnprintf(buf + len, 4096 - len, "event_%d %lld\n", i, value);
+    }
+    ret = simple_read_from_buffer(ubuf, count, ppos, buf, len);
+    kfree(buf);
+    return ret;
+}
+
+static const struct file_operations fops_nss_stats_diag = {
+    .read = ath11k_read_nss_stats_diag,
+    .open = simple_open,
+    .owner = THIS_MODULE,
+    .llseek = default_llseek,
 };
 
