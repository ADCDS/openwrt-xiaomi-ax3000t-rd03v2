# The WiFi watchdog, /usr/sbin/rd03v2-watchdog (docs/what-this-port-adds.md, Wi-Fi watchdog).
config watchdog 'main'
	# 0 stops it (as does touching /etc/rd03v2-watchdog.disable).
	option enabled '1'
	# 1: detect, write the evidence to /overlay/rd03v2-watchdog and log what
	# would be done (logread -e rd03v2-watchdog), but touch nothing. Shipped
	# acting (0). A root-PD crash is recovered by the kernel
	# (ath11k_ahb's user-PD respawn); the watchdog is the backstop when the
	# radios are not back, and for failures that raise no crash at all.
	option dryrun '0'
	# Before a driver reload, ath11k's own reset (hw-restart) of the affected
	# radio: '1' or '0' (unset: off). The reset restarts the root PD and both
	# radios recover in place in a few seconds; the default goes straight to
	# the reload, which rebuilds both radios from scratch.
	#option inplace '1'
	# Unload and load ath11k again before giving up and rebooting: '1' or '0'.
	# Host Wi-Fi mode only: with NSS Wi-Fi offload a reload leaves both radios
	# unable to complete a 4-way handshake until a reboot, so it reboots.
	option reload '1'
