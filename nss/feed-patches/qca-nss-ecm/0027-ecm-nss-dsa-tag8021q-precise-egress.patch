--- a/frontends/nss/ecm_nss_ported_ipv4.c
+++ b/frontends/nss/ecm_nss_ported_ipv4.c
@@ -1091,6 +1091,68 @@
 		}
 	}
 
+	/*
+	 * DSA/tag_8021q precise egress. ECM resolved the flow's L2 endpoints to
+	 * bare GMAC conduits (ecm_nss_common_dsa_conduit_get()), so this rule
+	 * carries no VLAN and the NSS emits routed frames UNTAGGED on the
+	 * conduit. The switch then classifies them into the CPU port's PVID
+	 * (pinned to the all-ports VID 0) and FLOODS - delivery works but is
+	 * gated by the slowest member port. Put each side's tag_8021q VID in the
+	 * rule instead, so the switch ARL-forwards precisely: the 'to' side VID
+	 * as egress_vlan_tag (flow-direction egress), the 'from' side VID as
+	 * ingress_vlan_tag (return-direction egress; it also matches the tag the
+	 * CPU port itself puts on ingress frames, since the per-VID egress
+	 * tagging on the CPU port is TAGGED for every tag_8021q VID).
+	 *
+	 * Routed connections only, and only when no real VLAN interface already
+	 * claimed the rule. The VID comes from each side's INNERMOST interface
+	 * ([x_ifaces_first]) - the same element whose AE number became the
+	 * rule's flow/return interface - which in every DSA-backed topology is
+	 * the DSA user port itself (br-lan/lanN, br-wan/lanN and
+	 * pppoe-wan -> br-wan -> lanN all resolve it there). Outer list
+	 * elements are never consulted: a bridge at the top of the list does
+	 * not imply the flow egresses a DSA port (it may egress a Wi-Fi
+	 * member of the same bridge). VID 0 means "not DSA/tag_8021q" and
+	 * leaves the rule alone.
+	 */
+	if (ecm_db_connection_is_routed_get(feci->ci)) {
+		uint16_t dsa_vid;
+		struct net_device *dsa_dev;
+
+		/*
+		 * Gate PER SIDE, not combined: an L3 interface that is itself a
+		 * VLAN netdev (br-lan.1 on a vlan_filtering bridge is the common
+		 * case) legitimately claims its own side via the VLAN branch
+		 * above, and the OTHER side still needs its tag_8021q VID or its
+		 * egress falls back to the PVID-0 flood.
+		 */
+		dsa_dev = NULL;
+		if (nircm->vlan_primary_rule.egress_vlan_tag == ECM_FRONT_END_VLAN_ID_NOT_CONFIGURED)
+			dsa_dev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(to_ifaces[to_ifaces_first]));
+		if (dsa_dev) {
+			dsa_vid = ecm_nss_common_dsa_8021q_vid_get(dsa_dev);
+			dev_put(dsa_dev);
+			if (dsa_vid) {
+				nircm->vlan_primary_rule.egress_vlan_tag = (ETH_P_8021Q << 16) | dsa_vid;
+				nircm->valid_flags |= NSS_IPV4_RULE_CREATE_VLAN_VALID;
+				DEBUG_TRACE("%px: dsa egress vid: %u\n", feci, dsa_vid);
+			}
+		}
+
+		dsa_dev = NULL;
+		if (nircm->vlan_primary_rule.ingress_vlan_tag == ECM_FRONT_END_VLAN_ID_NOT_CONFIGURED)
+			dsa_dev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(from_ifaces[from_ifaces_first]));
+		if (dsa_dev) {
+			dsa_vid = ecm_nss_common_dsa_8021q_vid_get(dsa_dev);
+			dev_put(dsa_dev);
+			if (dsa_vid) {
+				nircm->vlan_primary_rule.ingress_vlan_tag = (ETH_P_8021Q << 16) | dsa_vid;
+				nircm->valid_flags |= NSS_IPV4_RULE_CREATE_VLAN_VALID;
+				DEBUG_TRACE("%px: dsa ingress vid: %u\n", feci, dsa_vid);
+			}
+		}
+	}
