 	 * gated by the slowest member port. Put each side's tag_8021q VID in the
@@ -1104,7 +1104,7 @@
 	 * CPU port itself puts on ingress frames, since the per-VID egress
 	 * tagging on the CPU port is TAGGED for every tag_8021q VID).
 	 *
-	 * Routed connections only, and only when no real VLAN interface already
+	 * Routed and bridged connections, only when no real VLAN interface already
 	 * claimed the rule. The VID comes from each side's INNERMOST interface
 	 * ([x_ifaces_first]) - the same element whose AE number became the
 	 * rule's flow/return interface - which in every DSA-backed topology is
@@ -1115,7 +1115,7 @@
 	 * member of the same bridge). VID 0 means "not DSA/tag_8021q" and
 	 * leaves the rule alone.
 	 */
-	if (ecm_db_connection_is_routed_get(feci->ci)) {
+	{
 		uint16_t dsa_vid;
 		struct net_device *dsa_dev;
 
