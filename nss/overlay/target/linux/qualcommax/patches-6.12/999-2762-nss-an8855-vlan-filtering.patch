+static int an8855_port_vlan_filtering(struct dsa_switch *ds, int port,
+				      bool vlan_filtering,
+				      struct netlink_ext_ack *extack)
+{
+	/*
+	 * Never reprogram the CPU port here. an8855_setup() leaves every CPU
+	 * port at PVC_EG_TAG = EG_DISABLED so that the VLAN table's per-VID
+	 * egress-tag field decides, and an8855_vlan_add() makes CPU ports
+	 * tagged members of every VID.
+	 *
+	 * The mt7530-derived original instead forced EG_CONSISTENT on the
+	 * upstream port when enabling - "untagged in, untagged out". The
+	 * conduit then receives frames with no VLAN header at all, the
+	 * vsc73xx-8021q tagger has no VID to decode, and the host RX path dies
+	 * for every user port sharing that CPU port, bridged or not. It is
+	 * silent: the frame is dropped before the tagger's "Couldn't decode
+	 * source port" warning can fire. Recovery needed a reboot because the
+	 * disable path wrote EG_CONSISTENT as well and never restored the
+	 * tag_8021q programming.
+	 *
+	 * What remains is a re-commit of shadow state, the same shape as
+	 * vsc73xx_port_vlan_filtering().
+	 */
+	return an8855_port_commit_vlan(ds, port, vlan_filtering);
 }
 
