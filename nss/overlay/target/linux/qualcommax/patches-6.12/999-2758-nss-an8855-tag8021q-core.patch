+/*
+ * DEBUG: dump the tag_8021q-relevant switch programming to dmesg so it can be
+ * read over the serial console (no userspace tool needed). Prints, per port,
+ * the VLAN mode + both egress-tag controls + PVID + port matrix, and for the
+ * standalone VID range (0xC00 + port) the VLAN-table validity, VTAG_EN, member
+ * mask and per-port egress-tag field. Remove once tag_8021q is confirmed.
+ */
+static void an8855_tag_8021q_dump_vid(struct an8855_priv *priv, u16 vid)
+	__must_hold(&priv->reg_mutex)
+{
+	u32 vard;
+
+	if (an8855_vlan_cmd(priv, AN8855_VTCR_RD_VID, vid))
+		return;
+	if (regmap_read(priv->regmap, AN8855_VARD0, &vard))
+		return;
+
+	dev_info(priv->dev,
+		 "tag8021q VID%u: VARD0=%08x valid=%lu vtag_en=%lu members=%02lx etag=%03lx\n",
+		 vid, vard,
+		 (unsigned long)!!(vard & AN8855_VA0_VLAN_VALID),
+		 (unsigned long)!!(vard & AN8855_VA0_VTAG_EN),
+		 FIELD_GET(AN8855_VA0_PORT, vard),
+		 FIELD_GET(AN8855_VA0_ETAG, vard));
+}
+
+static void an8855_tag_8021q_debug_dump(struct an8855_priv *priv)
+{
+	struct dsa_switch *ds = priv->ds;
+	u32 pcr, pvc, pvid, mtx;
+	int port;
+	u16 vid;
+
+	for (port = 0; port < AN8855_NUM_PORTS; port++) {
+		if (regmap_read(priv->regmap, AN8855_PCR_P(port), &pcr) ||
+		    regmap_read(priv->regmap, AN8855_PVC_P(port), &pvc) ||
+		    regmap_read(priv->regmap, AN8855_PVID_P(port), &pvid) ||
+		    regmap_read(priv->regmap, AN8855_PORTMATRIX_P(port), &mtx))
+			continue;
+
+		dev_info(priv->dev,
+			 "tag8021q P%d[%s]: PCR=%08x mode=%lu pcr_egtag=%lu | PVC=%08x pvc_egtag=%lu attr=%lu acc=%lu spectag=%lu | PVID=%lu | matrix=%02lx\n",
+			 port, dsa_is_cpu_port(ds, port) ? "CPU" : "usr",
+			 pcr, FIELD_GET(AN8855_PORT_VLAN, pcr),
+			 FIELD_GET(AN8855_EG_TAG, pcr),
+			 pvc, FIELD_GET(AN8855_PVC_EG_TAG, pvc),
+			 FIELD_GET(AN8855_VLAN_ATTR, pvc),
+			 FIELD_GET(AN8855_ACC_FRM, pvc),
+			 (unsigned long)!!(pvc & AN8855_PORT_SPEC_TAG),
+			 FIELD_GET(AN8855_G0_PORT_VID, pvid),
+			 FIELD_GET(AN8855_PORTMATRIX, mtx));
+	}
+
+	mutex_lock(&priv->reg_mutex);
+	for (vid = 3072; vid < 3072 + AN8855_NUM_PORTS; vid++)
+		an8855_tag_8021q_dump_vid(priv, vid);
+	mutex_unlock(&priv->reg_mutex);
+}
