+	 * tagger is a hardware-agnostic tag_8021q implementation, so we reuse
+	 * it (requires CONFIG_NET_DSA_TAG_VSC73XX_8021Q).
+	 */
+	return DSA_TAG_PROTO_VSC73XX_8021Q;
