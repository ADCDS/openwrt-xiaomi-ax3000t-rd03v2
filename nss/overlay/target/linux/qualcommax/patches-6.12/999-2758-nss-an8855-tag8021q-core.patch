+static int an8855_port_change_conduit(struct dsa_switch *ds, int port,
+				      struct net_device *conduit,
+				      struct netlink_ext_ack *extack)
+{
+	struct an8855_priv *priv = ds->priv;
+	struct dsa_port *cpu_dp;
+	u32 matrix;
+	int ret;
+
+	/* No LAG offload support: a LAG of DSA conduits cannot be
+	 * represented in the port matrix.
+	 */
+	if (netif_is_lag_master(conduit)) {
+		NL_SET_ERR_MSG_MOD(extack, "LAG DSA conduit is not supported");
+		return -EOPNOTSUPP;
+	}
+
+	cpu_dp = conduit->dsa_ptr;
+	if (cpu_dp->ds != ds) {
+		NL_SET_ERR_MSG_MOD(extack, "Conduit is not a local CPU port");
+		return -EOPNOTSUPP;
+	}
+
+	/* Swap the CPU port in the port matrix: clear every CPU port bit,
+	 * keep the user (bridge peer) members and set the new CPU port.
+	 * Frames ingressing this port can then only egress the new CPU
+	 * port, while TX from either conduit is still steered to the
+	 * destination port by the DSA special tag.
+	 */
+	ret = regmap_read(priv->regmap, AN8855_PORTMATRIX_P(port), &matrix);
+	if (ret)
+		return ret;
+
+	matrix = FIELD_GET(AN8855_PORTMATRIX, matrix);
+	matrix &= ~dsa_cpu_ports(ds);
+	matrix |= BIT(cpu_dp->index);
+
+	ret = regmap_update_bits(priv->regmap, AN8855_PORTMATRIX_P(port),
+				 AN8855_PORTMATRIX,
+				 FIELD_PREP(AN8855_PORTMATRIX, matrix));
+	if (ret)
+		return ret;
+
+	/* Flush dynamic FDB entries of the port to avoid stale entries
+	 * resolved towards the old CPU port.
+	 */
+	an8855_port_fast_age(ds, port);
+
+	return 0;
+}
+
+/*
+ * tag_8021q support.
+ *
+ * The NSS/PPE datapath cannot parse the 4-byte Airoha special (MTK) tag that
+ * the CPU link uses by default, so it exceptions every routed frame to the
+ * host. Switching to DSA's tag_8021q model makes the CPU link carry a standard
+ * 802.1Q header (VID encodes the source/dest user port), which the NSS parses
+ * natively. dsa_tag_8021q_register() drives these two ops to program the VLAN
+ * table; the generic (hardware-agnostic) vsc73xx-8021q tagger provides the
+ * matching xmit/rcv on the conduit.
+ */
+static int an8855_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+				     u16 flags)
+{
+	bool untagged = flags & BRIDGE_VLAN_INFO_UNTAGGED;
+	bool pvid = flags & BRIDGE_VLAN_INFO_PVID;
+	struct an8855_priv *priv = ds->priv;
+	int ret;
+
+	/*
+	 * Program VLAN-table membership for this (port, vid). The core makes
+	 * every CPU/DSA port a tagged member of each VID and the owning user
+	 * port an untagged, PVID member of its own standalone VID.
+	 */
+	mutex_lock(&priv->reg_mutex);
+	ret = an8855_vlan_add(priv, port, vid, untagged);
+	mutex_unlock(&priv->reg_mutex);
+	if (ret)
+		return ret;
+
+	/*
+	 * For the owning user port, become VLAN-aware so its PVID (the
+	 * standalone VID) is applied to untagged ingress and carried to the
+	 * CPU. Mirrors the vlan_filtering() user-port setup: SECURITY mode,
+	 * egress untagged towards the client, accept all frames.
+	 */
+	if (pvid) {
+		ret = an8855_port_set_vlan_mode(priv, port,
+						AN8855_PORT_SECURITY_MODE,
+						AN8855_VLAN_EG_DISABLED,
+						AN8855_VLAN_USER,
+						AN8855_VLAN_ACC_ALL);
+		if (ret)
+			return ret;
+
+		ret = an8855_port_set_pvid(priv, port, vid);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int an8855_tag_8021q_vlan_del(struct dsa_switch *ds, int port, u16 vid)
+{
+	struct an8855_priv *priv = ds->priv;
+	int ret;
+
+	mutex_lock(&priv->reg_mutex);
+	ret = an8855_vlan_del(priv, port, vid);
+	mutex_unlock(&priv->reg_mutex);
+
+	return ret;
+}
+
+static void an8855_teardown(struct dsa_switch *ds)
+{
+	rtnl_lock();
+	dsa_tag_8021q_unregister(ds);
+	rtnl_unlock();
+}
